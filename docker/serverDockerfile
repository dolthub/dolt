# syntax=docker/dockerfile:1

FROM debian:bookworm-slim AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        curl git tini ca-certificates && \
    rm -rf /var/lib/apt/lists/*


# We use bookworm since the icu dependency ver. between the base and golang images is the same
FROM golang:1.26.2-bookworm AS build-from-source
ENV DEBIAN_FRONTEND=noninteractive
ARG DOLT_VERSION

# Support building from either repo root (go/) or workspace root (dolt/go/)
COPY dolt*/go*/go.mod* go*/go.mod* /tmp/dolt/go/
COPY dolt*/go*/go.sum* go*/go.sum* /tmp/dolt/go/
WORKDIR /tmp/dolt/go/

# Check for source to avoid unnecessary installation of build dependencies
RUN if [ "$DOLT_VERSION" = "source" ]; then \
        cd /tmp/dolt/go || { echo "Make sure the dolt source exists in your workspace to build from source."; exit 1; }; \
        apt-get update -y && \
        apt-get install -y --no-install-recommends libicu-dev && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Use BuildKit cache mount to avoid redundant downloads across builds
RUN --mount=type=cache,target=/go/pkg/mod \
    if [ "$DOLT_VERSION" = "source" ]; then \
        go mod download; \
    fi

COPY dolt*/go/ go/ /tmp/dolt/go/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    if [ "$DOLT_VERSION" = "source" ]; then \
        go build -ldflags="-w" -o /usr/local/bin/dolt ./cmd/dolt && \
        chmod +x /usr/local/bin/dolt; \
    fi


FROM base AS download-binary
ARG DOLT_VERSION
RUN if [ "$DOLT_VERSION" = "latest" ]; then \
        # Fetch latest version number from GitHub API
        DOLT_VERSION=$(curl -s https://api.github.com/repos/dolthub/dolt/releases/latest \
            | grep '"tag_name"' \
            | cut -d'"' -f4 \
            | sed 's/^v//'); \
    fi && \
    if [ "$DOLT_VERSION" != "source" ] && [ "$DOLT_VERSION" != "local" ]; then \
        curl -L "https://github.com/dolthub/dolt/releases/download/v${DOLT_VERSION}/install.sh" | bash; \
    fi


FROM base AS local-binary
ARG DOLT_VERSION
RUN mkdir -p /tmp/dolt-bin
COPY *ci_bin/dolt* dolt*/*ci_bin/dolt* *bin/dolt* dolt*/*bin/dolt* /tmp/dolt-bin/
RUN if [ "$DOLT_VERSION" = "local" ]; then \
        if [ -f /tmp/dolt-bin/dolt ]; then \
            cp /tmp/dolt-bin/dolt /usr/local/bin/dolt && \
            chmod +x /usr/local/bin/dolt; \
        else \
            echo "Error: DOLT_VERSION=local specified but no pre-built dolt binary found in .ci_bin/ or bin/" && exit 1; \
        fi \
    fi


FROM base AS runtime
ARG DOLT_VERSION

RUN apt-get update -y && apt-get install -y --no-install-recommends bzip2 gzip xz-utils zstd \
  && rm -rf /var/lib/apt/lists/*
# icu dependency for source and local builds
RUN if [ "$DOLT_VERSION" = "source" ] || [ "$DOLT_VERSION" = "local" ]; then \
        apt-get update -y && \
        apt-get install -y --no-install-recommends libicu-dev && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Copy binary from whichever stage built or copied it
COPY --from=download-binary /usr/local/bin/dolt* /usr/local/bin/
COPY --from=build-from-source /usr/local/bin/dolt* /usr/local/bin/
COPY --from=local-binary /usr/local/bin/dolt* /usr/local/bin/

RUN /usr/local/bin/dolt version

RUN mkdir /docker-entrypoint-initdb.d && \
    mkdir -p /var/lib/dolt && \
    chmod 755 /var/lib/dolt

COPY docker*/docker-entrypoint*.sh /usr/local/bin/
COPY dolt*/docker*/docker-entrypoint*.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

VOLUME /var/lib/dolt
EXPOSE 3306 33060 7007
WORKDIR /var/lib/dolt
ENTRYPOINT ["tini", "--", "docker-entrypoint.sh"]
